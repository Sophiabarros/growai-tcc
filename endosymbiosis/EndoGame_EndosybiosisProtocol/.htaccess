# Apache: compression + caching for the GDevelop web build
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  # Images/audio/fonts carry a content hash in their file name -> safe to cache "forever"
  <FilesMatch "\.(png|jpe?g|webp|ico|ogg|mp3|wav|ttf|otf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Code and data keep the same name on every export -> always revalidate
  <FilesMatch "\.(html|js|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
