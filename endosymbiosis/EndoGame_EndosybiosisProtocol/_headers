# Netlify / Cloudflare Pages: caching for the GDevelop web build (compression is automatic there)
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.ogg
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/favicon.ico
  Cache-Control: public, max-age=604800
