# --- Local (arquivo backend/.env) ---
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growai
# SSL do banco. A URL do Neon ja traz ?sslmode=require e isso basta; use
# DB_SSL=true so para um Postgres cuja URL nao pede SSL. DB_SSL_CA recebe o
# certificado da CA (com \n no lugar das quebras de linha), se o provedor exigir.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
# Conexoes simultaneas no pool (padrao 10)
DB_POOL_MAX=10
JWT_SECRET=troque-por-um-segredo-forte-aqui
CORS_ORIGIN=http://localhost:5500
# Chave de API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Endereço que recebe as mensagens do formulário "Contate-nos" da página Sobre nós
CONTACT_TO_EMAIL=tracklink.system@gmail.com
# --- Recuperação de senha (e-mails enviados pelo Resend) ---
# Remetente. O padrão (onboarding@resend.dev) só entrega para o e-mail dono da
# conta Resend; para enviar a qualquer usuário, verifique um domínio no Resend
# e use algo como: TrackLink <no-reply@seudominio.com>
MAIL_FROM=TrackLink <onboarding@resend.dev>
# Endereço público do site (o link do e-mail aponta para FRONTEND_URL/redefinir-senha.html)
FRONTEND_URL=http://localhost:5500
# Validade do link de redefinição, em minutos (padrão: 30)
RESET_TOKEN_TTL_MIN=30

# Limite do corpo JSON (padrao 1mb)
JSON_LIMITE=1mb

# --- Placas ESP32 (/api/device) ---
# Tamanho maximo da foto da ESP32-CAM em POST /api/device/foto, em MB (padrao 4)
FOTO_LIMITE_MB=4
# Intervalo do ping do WebSocket (/ws), em ms (padrao 30000). Quem nao
# responder ao ping anterior e desconectado.
WS_PING_MS=30000
# As chaves das placas NAO ficam aqui: elas sao geradas por
#   npm run criar-dispositivo -- <station_id> <main|cam>
# que grava apenas o sha256 no banco e imprime a chave uma vez, para colar no
# secrets.h da placa (ver firmware/README.md).
# DEVICE_LOG=1 imprime cada telemetria e cada foto no console (util no dev).
DEVICE_LOG=0
# MOCK_SENSOR=1 volta a gerar leitura simulada em
# GET /stations/:id/readings/latest, para mexer no layout sem placa ligada.
MOCK_SENSOR=0

# --- IA (analise visual das fotos) ---
# gemini (padrao) ou claude
IA_PROVIDER=gemini
# IA_HABILITADA=false salva as fotos como 'indefinido' sem chamar a IA.
IA_HABILITADA=true
# Timeout da chamada, em ms (padrao 25000).
IA_TIMEOUT_MS=25000
# Minutos entre analises de foto POR ESTACAO (padrao 180 = 8 por dia).
# A CAM manda 48 fotos/dia; a cota gratuita do Gemini e 20 requisicoes/dia por
# modelo. A foto e sempre guardada, so a analise e espacada. Com cota paga,
# baixe para 30 e todas serao analisadas.
IA_FOTO_INTERVALO_MIN=180
# Horas que a IA espera antes de mexer de novo na MESMA estacao (padrao 6).
# Sem isso a rotina mudaria a cada foto e a planta nunca estabilizaria.
IA_AUTOAJUSTE_COOLDOWN_H=6
# Minutos de carencia entre avaliacoes de rotina da mesma estacao (padrao 2).
IA_ROTINA_COOLDOWN_MIN=2
# Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NAO use modelos "lite" (gemini-*-flash-lite): testados aqui, eles inventam
# uma planta saudavel numa foto preta em vez de pedir outra foto.
GEMINI_MODEL=gemini-3.6-flash
# Claude - https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5


# --- Produção (Environment do serviço growai-backend no Render; ver render.yaml) ---
# O deploy antigo na Vercel usa as mesmas variáveis.
# DATABASE_URL  -> connection string do Postgres (Neon/Supabase). Use a
#                  string COM POOLER (-pooler) do Neon para serverless.
# JWT_SECRET    -> segredo forte (o mesmo entre deploys, senão desloga todo mundo)
# CORS_ORIGIN   -> URL do front-end na Vercel, ex.: https://growai-claude.vercel.app
# RESEND_API_KEY, MAIL_FROM, FRONTEND_URL -> OBRIGATÓRIAS para "esqueci minha senha"
#                  (FRONTEND_URL = https://growai-xi.vercel.app)
# CONTACT_TO_EMAIL -> só se for usar /api/contact pelo backend
# PORT          -> NÃO definir no Render nem na Vercel (a plataforma injeta)
# IA_PROVIDER + GEMINI_API_KEY (ou ANTHROPIC_API_KEY) -> OBRIGATÓRIAS para a
#                  análise das fotos. Sem elas a foto é salva como
#                  'indefinido' e o app mostra "Sem análise".
# IA_HABILITADA, IA_TIMEOUT_MS, GEMINI_MODEL, CLAUDE_MODEL -> opcionais
# DEVICE_LOG    -> deixe 0 (ou não defina) em produção
# MOCK_SENSOR   -> NÃO definir em produção (voltaria a inventar leituras)
